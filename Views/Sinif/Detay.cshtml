@model PerformansTakip.Models.Sinif

<h1>@Model.Ad Sınıfı Öğrencileri</h1>
<table>
    <thead>
        <tr>
            <th>Ad</th>
            <th>Soyad</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ogrenci in Model.Ogrenciler)
        {
            <tr>
                <td>@ogrenci.Ad |</td>
                
                <td>@ogrenci.Soyad</td>
            </tr>
        }
    </tbody>
</table>
<a href="@Url.Action("Index", "Sinif")">Geri Dön</a>